---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .map((entry) => {
    const data = entry.data ?? {};
    return {
      ...entry,
      data: {
        ...data,
        title: typeof data.title === 'string' && data.title.trim().length > 0 ? data.title : entry.slug,
        description: typeof data.description === 'string' ? data.description : '',
        heroImage: typeof data.heroImage === 'string' ? data.heroImage : undefined,
        tags: Array.isArray(data.tags)
          ? data.tags.filter((tag) => typeof tag === 'string' && tag.trim().length > 0)
          : []
      }
    };
  })
  .sort((a, b) => {
    const orderA = typeof a.data.order === 'number' ? a.data.order : Number.MAX_SAFE_INTEGER;
    const orderB = typeof b.data.order === 'number' ? b.data.order : Number.MAX_SAFE_INTEGER;
    if (orderA === orderB) {
      return a.data.title.localeCompare(b.data.title, undefined, { sensitivity: 'base' });
    }
    return orderA - orderB;
  });
---

<BaseLayout
  title="Blog — The Real Dealmaker"
  description="Preparing Your Business To Exit At Top Dollar Valuation Part 2, Join The Dream Team, Preparing Your Business To Exit At Top Dollar Valuation Part 1, and Who I Am And Why It Matters To You!"
>
  <section>
    <div class="section-heading">
      <span class="badge">Blog</span>
      <h1>Blog</h1>
    </div>
    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          {post.data.heroImage && (
            <a href={post.slug}>
              <img class="shadowed-image" src={post.data.heroImage} alt={post.data.title} loading="lazy" />
            </a>
          )}
          <h2><a href={post.slug}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
          <a class="button secondary" href={post.slug} style="margin-top:1.25rem;">Read More</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
